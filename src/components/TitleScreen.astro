---
import { CONFIG } from '../config';
import { HIBISCUS, DAISY, SPRIG } from './Decor';
---
<section id="title-screen" class="title" aria-labelledby="title-h">
  <div class="sky" aria-hidden="true">
    <span class="cloud c1"></span><span class="cloud c2"></span><span class="cloud c3"></span>
  </div>

  <div class="sign-wrap">
    <span class="rope l" aria-hidden="true"></span><span class="rope r" aria-hidden="true"></span>
    <h1 id="title-h" class="wood-sign">
      <span class="sprig left" set:html={SPRIG} />
      {CONFIG.titulo}
      <span class="sprig right" set:html={SPRIG} />
    </h1>
    <div class="ribbon"><span class="spark l" aria-hidden="true"></span><span id="title-stop">Parada 1 de 5</span><span class="spark r" aria-hidden="true"></span></div>
  </div>

  <div class="bottom">
    <button id="start-btn" class="btn-big" type="button">
      <span class="spark l" aria-hidden="true"></span>Ir a la primera parada<span class="spark r" aria-hidden="true"></span>
    </button>
    <p class="keys-hint">
      <span class="desk">Flechas o WASD para caminar · Espacio para hablar · J para el diario</span>
      <span class="mob">Toca y arrastra para caminar · botón A para hablar</span>
    </p>
  </div>

  <div class="corner cl" aria-hidden="true"><span class="hib" set:html={HIBISCUS} /><span class="daisy" set:html={DAISY} /></div>
  <div class="corner cr" aria-hidden="true"><span class="hib" set:html={HIBISCUS} /><span class="daisy" set:html={DAISY} /></div>
</section>

<style>
  .title {
    position: fixed; inset: 0; z-index: 50; pointer-events: none; overflow: hidden;
    display: flex; flex-direction: column; justify-content: space-between; align-items: center;
    padding: 0 16px max(18px, env(safe-area-inset-bottom));
    transition: opacity .7s ease, visibility .7s;
  }
  .title::before {
    content: ''; position: absolute; inset: 0 0 auto 0; height: 26%;
    background: linear-gradient(180deg, #5cb8f0 0%, #8fd3f2 55%, rgba(143, 211, 242, 0) 100%);
  }
  .title:global(.hide) { opacity: 0; visibility: hidden; }
  .sky { position: absolute; inset: 0 0 auto 0; height: 26%; overflow: hidden; }
  .cloud { position: absolute; width: 150px; height: 46px; background: #fff; border-radius: 40px; opacity: .95; animation: drift 46s linear infinite; }
  .cloud::before, .cloud::after { content: ''; position: absolute; background: #fff; border-radius: 50%; }
  .cloud::before { width: 64px; height: 64px; left: 20px; top: -32px; }
  .cloud::after { width: 50px; height: 50px; left: 72px; top: -20px; }
  .c1 { top: 38%; left: -10%; }
  .c2 { top: 8%; left: 60%; animation-duration: 60s; scale: .7; }
  .c3 { top: 20%; left: 85%; animation-duration: 70s; scale: .6; }
  @keyframes drift { from { translate: -40vw 0; } to { translate: 60vw 0; } }

  .sign-wrap { position: relative; display: flex; flex-direction: column; align-items: center; padding-top: max(26px, env(safe-area-inset-top)); width: 100%; }
  .rope { position: absolute; top: 0; width: 6px; height: 40px; border-radius: 3px; background: repeating-linear-gradient(45deg, #c9a46a 0 4px, #a8834b 4px 8px); }
  .rope.l { left: calc(50% - min(150px, 36vw)); }
  .rope.r { right: calc(50% - min(150px, 36vw)); }
  .wood-sign {
    position: relative; margin: 0; padding: 14px clamp(44px, 10vw, 60px) 16px; border-radius: 22px;
    font: 700 clamp(1.7rem, 7.6vw, 2.6rem)/1.05 var(--font-display); color: #fff6e6; text-align: center;
    text-shadow: 0 3px 0 #6b4220, 0 0 2px #6b4220;
    background:
      repeating-linear-gradient(176deg, rgba(255, 255, 255, .06) 0 6px, transparent 6px 14px),
      linear-gradient(180deg, #a8703f 0%, #8b5a2f 100%);
    box-shadow: 0 6px 0 #5e3b1c, 0 14px 26px rgba(40, 30, 10, .35), inset 0 2px 0 rgba(255, 255, 255, .25);
    animation: swing 4s ease-in-out infinite; transform-origin: 50% -40px;
  }
  .sprig { position: absolute; top: 50%; width: 26px; height: 26px; translate: 0 -50%; }
  .sprig :global(svg) { width: 100%; height: 100%; display: block; }
  .sprig.left { left: 12px; transform: scaleX(-1); }
  .sprig.right { right: 12px; }
  @keyframes swing { 0%, 100% { rotate: -1.2deg; } 50% { rotate: 1.2deg; } }

  .ribbon {
    position: relative; margin-top: 14px; padding: 9px 30px; border-radius: 6px;
    background: linear-gradient(180deg, #ffe680, #ffd23f); color: #5b3a12;
    font: 700 clamp(1.05rem, 4.6vw, 1.35rem)/1 var(--font-display);
    box-shadow: 0 4px 0 #d9a520, 0 10px 18px rgba(80, 60, 0, .2);
  }
  .ribbon::before, .ribbon::after {
    content: ''; position: absolute; top: 8px; width: 22px; height: 100%; background: #f2bf2a; z-index: -1;
  }
  .ribbon::before { left: -14px; clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%, 40% 50%); }
  .ribbon::after { right: -14px; clip-path: polygon(0 0, 100% 0, 60% 50%, 100% 100%, 0 100%); }

  .spark { position: absolute; top: 50%; width: 22px; height: 18px; translate: 0 -50%; }
  .spark::before, .spark::after, .spark { background: none; }
  .spark::before, .spark::after { content: ''; position: absolute; left: 0; width: 16px; height: 3px; border-radius: 2px; background: #ffcf3a; }
  .spark::before { top: 2px; rotate: -25deg; }
  .spark::after { bottom: 2px; rotate: 25deg; }
  .spark.l { left: -30px; }
  .spark.r { right: -30px; scale: -1 1; }
  .ribbon .spark.l { left: -48px; }
  .ribbon .spark.r { right: -48px; }

  .bottom { position: relative; z-index: 2; display: flex; flex-direction: column; align-items: center; gap: 10px; }
  .btn-big {
    pointer-events: auto; position: relative; min-height: 62px; padding: 0 clamp(36px, 9vw, 52px); border: 0; border-radius: 99px; cursor: pointer;
    background: linear-gradient(180deg, #ff8a6e 0%, #f0604f 100%); color: #fff7ec;
    font: 700 clamp(1.2rem, 5vw, 1.6rem)/1 var(--font-display); text-shadow: 0 2px 0 #b8402f;
    box-shadow: 0 7px 0 #b8402f, 0 16px 30px rgba(150, 40, 20, .35), inset 0 2px 0 rgba(255, 255, 255, .35);
    transition: transform .12s, box-shadow .12s; animation: bob 2.2s ease-in-out infinite;
  }
  .btn-big:active { transform: translateY(5px); box-shadow: 0 2px 0 #b8402f; }
  .btn-big .spark.l { left: 12px; }
  .btn-big .spark.r { right: 12px; }
  @keyframes bob { 50% { translate: 0 -3px; } }
  .keys-hint { margin: 0; padding: 6px 14px; border-radius: 99px; background: rgba(255, 248, 232, .85); font-size: .8rem; font-weight: 700; color: var(--ink-soft); text-align: center; }
  .keys-hint .mob { display: none; }
  :global(body.touch) .keys-hint .mob { display: inline; }
  :global(body.touch) .keys-hint .desk { display: none; }

  .corner { position: absolute; bottom: -18px; width: clamp(110px, 26vw, 180px); z-index: 1; }
  .corner.cl { left: -26px; }
  .corner.cr { right: -26px; transform: scaleX(-1); }
  .hib :global(svg) { width: 100%; display: block; }
  .daisy { position: absolute; width: 38%; right: -6%; bottom: 8%; }
  .daisy :global(svg) { width: 100%; display: block; }
  @media (prefers-reduced-motion: reduce) { .wood-sign, .btn-big, .cloud { animation: none; } }
</style>

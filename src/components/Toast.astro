<div id="toast" class="toast" role="status" aria-live="polite"></div>

<style>
  .toast {
    position: fixed; left: 50%; top: 104px; z-index: 25; width: max-content; max-width: calc(100vw - 32px); padding: 12px 20px; border-radius: 22px;
    background: var(--ink); color: #fff; font-weight: 800; font-size: .95rem; text-align: center;
    transform: translate(-50%, -20px); opacity: 0; transition: opacity .3s, transform .3s; pointer-events: none;
  }
  .toast:global(.show) { opacity: 1; transform: translate(-50%, 0); }
</style>

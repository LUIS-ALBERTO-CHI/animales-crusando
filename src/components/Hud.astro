---
---
<header id="hud" class="hud" aria-label="Progreso">
  <div class="pill">
    <div class="row">
      <span id="hud-shells" class="hearts" aria-hidden="true"></span>
      <span class="count" aria-live="polite"><span id="hud-count">0/5</span> conchas</span>
    </div>
    <p id="hud-goal" class="goal">Parada 1</p>
  </div>
  <div class="buttons">
    <button id="btn-journal" class="icon-btn" type="button" aria-label="Abrir diario de virtudes" title="Diario (J)">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4.5A2.5 2.5 0 0 1 7.5 2H19v17H7.5A2.5 2.5 0 0 0 5 21.5z" fill="currentColor" opacity=".25"/><path d="M5 4.5A2.5 2.5 0 0 1 7.5 2H19v17H7.5A2.5 2.5 0 0 0 5 21.5zm0 17A2.5 2.5 0 0 1 7.5 19H19v3H7.5A2.5 2.5 0 0 1 5 21.5z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M12 13.5s-3-1.8-3-4a1.6 1.6 0 0 1 3-.8 1.6 1.6 0 0 1 3 .8c0 2.2-3 4-3 4z" fill="currentColor"/></svg>
    </button>
    <button id="btn-sound" class="icon-btn" type="button" aria-label="Silenciar sonido" aria-pressed="false" title="Sonido">
      <svg class="on" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9h4l5-4v14l-5-4H4z" fill="currentColor"/><path d="M16 8.5a5 5 0 0 1 0 7M18.5 6a8.5 8.5 0 0 1 0 12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
      <svg class="off" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9h4l5-4v14l-5-4H4z" fill="currentColor"/><path d="M16.5 9.5l5 5m0-5l-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
    </button>
  </div>
</header>

<style>
  .hud {
    position: fixed; top: 0; left: 0; right: 0; z-index: 20; display: flex; justify-content: space-between; align-items: flex-start;
    gap: 10px; padding: max(12px, env(safe-area-inset-top)) 16px 0; pointer-events: none;
    opacity: 0; transform: translateY(-12px); transition: opacity .5s, transform .5s;
  }
  .hud:global(.show) { opacity: 1; transform: none; }
  .pill {
    pointer-events: auto; background: var(--cream); border-radius: 22px; padding: 9px 16px 10px;
    box-shadow: 0 4px 0 var(--cream-dark), 0 8px 20px rgba(40, 60, 50, .18); max-width: min(360px, 70vw);
  }
  .row { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .hearts { display: flex; gap: 3px; }
  .hearts :global(span) { width: 20px; height: 20px; color: #e6d6c4; transition: color .3s; }
  .hearts :global(span.on) { color: #f5a3c0; filter: drop-shadow(0 0 4px rgba(255, 210, 120, .9)); animation: pop .5s ease; }
  .hearts :global(svg) { width: 100%; height: 100%; display: block; }
  @keyframes pop { 50% { transform: scale(1.45); } }
  .count { font: 600 .95rem/1 var(--font-display); color: var(--ink); }
  .goal { margin: 5px 0 0; font-size: .85rem; color: var(--ink-soft); font-weight: 700; }
  .buttons { display: flex; gap: 8px; pointer-events: auto; }
  .icon-btn {
    width: 48px; height: 48px; border: 0; border-radius: 50%; display: grid; place-items: center; cursor: pointer;
    background: var(--cream); color: var(--ink); box-shadow: 0 4px 0 var(--cream-dark), 0 8px 18px rgba(40, 60, 50, .18);
    transition: transform .12s, box-shadow .12s;
  }
  .icon-btn:active { transform: translateY(3px); box-shadow: 0 1px 0 var(--cream-dark); }
  .icon-btn svg { width: 24px; height: 24px; }
  .icon-btn .off { display: none; }
  .icon-btn:global(.off) .off { display: block; }
  .icon-btn:global(.off) .on { display: none; }
</style>
